          "twitter:title",
          "twitter:description",
          "twitter:image"
        ],
        "localSEO": [
          "geo.region",
          "geo.placename",
          "geo.position",
          "ICBM"
        ],
        "structuredData": {
          "type": "CafeOrCoffeeShop (Schema.org JSON-LD)",
          "includes": [
