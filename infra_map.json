    ]
  },
  "integrations": {
    "firebase": {
      "service": "Firebase Authentication",
      "projectId": "fir-35bde",
      "methods": [
        "Email/Password",
        "Google OAuth (popup)",
        "Phone SMS (RecaptchaVerifier)"
      ],
      "sdkVersion": "v12 Web Modular SDK",
      "stateSync": "onAuthStateChanged → custom 'auth:change' event on window"
    },
    "whatsApp": {
      "service": "WhatsApp Business Chat Links",
      "baseUrl": "https://wa.me/",
      "number": "15552348901",
      "touchpoints": [
        "Header nav button",
        "Floating sticky button (bottom-right)",
        "Contact section CTA",
        "Per-menu-item 'Ask on WhatsApp' buttons"
      ],
      "messageTemplates": {
        "general": "Hi Komorebi Cafe! 🌿 I came across your website and would love to ask a question about your menu and hours.",
        "event": "Hi Komorebi Cafe! ☕ I'd like to ask about reserving a table or hosting a private event with you!",
        "menuItem": "Hi Komorebi Cafe! 🌿 I saw the \"{itemName}\" on your website and would love to ask about availability/details."
      }
    },
    "googleFonts": {
      "service": "Google Fonts CDN",
      "fonts": [
        "Lora",
        "Plus Jakarta Sans"
      ],
      "preconnect": [
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ]
    }
  },
  "dataFlow": {
    "menuRendering": "data.js (MENU_ITEMS) → app.js renderMenuItems() → #menu-grid DOM",
    "categoryFiltering": "User clicks category tab → activeCategory state → renderMenuItems() re-filter",
    "searchFiltering": "User types in #search-input → searchQuery state → renderMenuItems() re-filter",
    "authentication": "User action → auth.js (Firebase SDK) → onAuthStateChanged → 'auth:change' event → app.js renderAuthNav() → re-render menu hearts",
    "favorites": "User clicks ❤️ → auth.js toggleFavorite() → localStorage persist → 'auth:change' → UI update",
    "storeStatus": "CAFE_INFO.hours + new Date() → Open/Closed badge in #status-badge",
    "whatsAppLinks": "CAFE_INFO.whatsappNumber + message template → wa.me URL → attached to all WhatsApp buttons"
  },
  "localStorage": {
    "komorebi_fav_{userId}": {
      "type": "JSON array of item IDs",
      "purpose": "Persist per-user menu favorites across sessions"
    },
    "komorebi_firebase_config": {
      "note": "Legacy key — actively purged on init to prevent stale config"
    }
  },
  "securityModel": {
    "csp": {
      "defaultSrc": "'self'",
      "scriptSrc": "'self' 'unsafe-inline' accounts.google.com *.firebaseapp.com apis.google.com",
      "styleSrc": "'self' 'unsafe-inline' fonts.googleapis.com accounts.google.com",
      "fontSrc": "'self' fonts.gstatic.com data:",
      "imgSrc": "'self' data: https: blob:",
      "connectSrc": "'self' wa.me accounts.google.com *.firebaseapp.com *.googleapis.com identitytoolkit.googleapis.com securetoken.googleapis.com wss://*.firebaseio.com",
      "frameSrc": "'self' accounts.google.com *.firebaseapp.com"
    },
    "xssProtection": "escapeHtml() utility in app.js sanitizes all user-derived content before DOM insertion",
    "referrer": "strict-origin-when-cross-origin",
    "contentType": "X-Content-Type-Options: nosniff"
  },
  "seoStructuredData": {
