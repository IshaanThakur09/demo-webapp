    },
    "package.json": {
      "role": "Project manifest & dependency definitions"
    },
    ".gitignore": {
      "role": "Git ignore rules (node_modules, dist, logs, IDE)"
    }
  },
  "modules": {
    "data.js": {
      "path": "js/data.js",
      "type": "ES Module",
      "exports": [
        "CAFE_INFO",
        "MENU_CATEGORIES",
        "MENU_ITEMS"
      ],
      "windowGlobals": [
        "CAFE_INFO",
        "MENU_CATEGORIES",
        "MENU_ITEMS"
      ],
      "importedBy": [
        "js/app.js"
      ],
      "constants": {
        "CAFE_INFO": {
          "fields": [
            "name",
            "tagline",
            "address",
            "phone",
            "whatsappNumber",
            "whatsappDisplay",
            "email",
            "geo",
            "hours"
          ],
          "purpose": "Central cafe metadata — used for WhatsApp links, store hours, SEO, contact section"
        },
        "MENU_CATEGORIES": {
          "count": 5,
          "ids": [
            "all",
            "coffee",
            "matcha-tea",
            "bakery",
            "brunch"
          ],
          "purpose": "Tab pill filters for the menu grid"
        },
        "MENU_ITEMS": {
          "count": 12,
          "fields": [
            "id",
            "name",
            "category",
            "price",
            "description",
            "tags",
            "image",
            "highlights"
          ],
          "purpose": "Full menu card data rendered into the menu grid"
        }
      }
    },
    "auth.js": {
      "path": "js/auth.js",
      "type": "ES Module",
      "exports": [
        "AuthManager (class)",
        "authInstance (singleton)"
      ],
      "importedBy": [
        "js/app.js"
      ],
      "firebaseImports": [
        "initializeApp",
        "getApps",
        "getApp",
        "getAuth",
        "createUserWithEmailAndPassword",
        "signInWithEmailAndPassword",
        "signOut",
        "onAuthStateChanged",
        "GoogleAuthProvider",
        "signInWithPopup",
        "RecaptchaVerifier",
        "signInWithPhoneNumber",
        "updateProfile"
      ],
      "firebaseConfig": {
        "projectId": "fir-35bde",
        "authDomain": "fir-35bde.firebaseapp.com",
        "storageBucket": "fir-35bde.firebasestorage.app",
        "measurementId": "G-D8JXC8XLCL"
      },
      "authMethods": {
        "email": {
          "register": "registerWithEmail({ name, email, password })",
          "login": "loginWithEmail(email, password)",
          "features": [
            "Input validation",
            "Firebase updateProfile with display name & avatar URL"
          ]
        },
        "google": {
          "method": "loginWithGoogle()",
          "flow": "signInWithPopup with GoogleAuthProvider",
          "scopes": [
            "profile",
            "email"
          ],
          "customParams": {
            "prompt": "select_account"
          }
        },
        "phone": {
          "sendOTP": "sendPhoneOTP(countryCode, phoneNumber, recaptchaContainerId)",
          "verifyOTP": "verifyPhoneOTP(inputOTP)",
          "features": [
            "RecaptchaVerifier (invisible)",
            "Fallback mock OTP for local dev",
            "6-digit code validation"
          ],
          "customEvents": [
            "auth:sms_sent"
          ]
        }
      },
      "userModel": {
        "fields": [
          "uid",
          "id",
          "name",
          "email",
          "phone",
          "avatar",
          "provider",
          "favorites",
          "loggedInAt"
        ],
        "avatarFallback": "https://ui-avatars.com/api/"
      },
      "stateManagement": {
        "listener": "onAuthStateChanged (Firebase real-time)",
        "customEvent": "auth:change (dispatched on window)",
        "favoritesStorage": "localStorage key: komorebi_fav_{userId}"
      },
      "publicAPI": [
        "isAuthenticated()",
        "getUser()",
        "logout()",
        "registerWithEmail()",
        "loginWithEmail()",
        "loginWithGoogle()",
        "sendPhoneOTP()",
        "verifyPhoneOTP()",
        "toggleFavorite(itemId)",
        "isFavorite(itemId)",
        "updateProfile({ name, avatar })",
        "loadUserFavorites(userId)",
        "saveUserFavorites(userId, favorites)",
        "formatFirebaseError(err)"
      ]
    },
    "app.js": {
      "path": "js/app.js",
      "type": "ES Module",
      "imports": {
        "from data.js": [
          "CAFE_INFO",
          "MENU_CATEGORIES",
          "MENU_ITEMS"
        ],
        "from auth.js": [
          "authInstance"
        ]
      },
      "initFlow": [
        "DOMContentLoaded listener",
        "renderCategoryTabs()",
        "renderMenuItems()",
        "updateLiveStoreStatus()",
        "setupWhatsAppLinks()",
        "renderAuthNav()",
        "setupAuthEventListeners()",
        "setupProfileEventListeners()"
      ],
      "uiControllers": {
        "storeStatus": {
          "function": "updateLiveStoreStatus()",
          "domTarget": "#status-badge",
          "logic": "Compares current time to CAFE_INFO.hours to show Open/Closed badge"
        },
        "whatsApp": {
          "function": "setupWhatsAppLinks()",
          "buttons": [
            "#hero-whatsapp-btn",
            "#floating-whatsapp-btn",
            "#contact-whatsapp-btn"
          ],
          "urlBuilder": "buildWhatsAppUrl(customText) → https://wa.me/{number}?text={encoded}"
        },
        "menuRendering": {
          "categoryTabs": {
            "function": "renderCategoryTabs()",
            "container": "#menu-categories",
            "stateVar": "activeCategory"
          },
          "menuGrid": {
            "function": "renderMenuItems()",
            "container": "#menu-grid",
            "features": [
              "Category filtering",
              "Text search filtering",
              "Favorite heart toggles",
              "Per-item WhatsApp inquiry links",
              "Empty state message"
            ]
          },
          "search": {
            "input": "#search-input",
            "stateVar": "searchQuery",
            "event": "input → renderMenuItems()"
          }
        },
        "authentication": {
          "navRenderer": "renderAuthNav()",
          "states": {
            "signedOut": "Shows Log In button → opens auth modal",
            "signedIn": "Shows avatar badge with dropdown menu (Sign Out)"
          },
          "modal": {
            "overlay": "#auth-modal",
            "tabs": {
              "email": {
                "panelId": "#panel-email",
                "tabBtn": "#tab-email-btn"
              },
              "google": {
                "panelId": "#panel-google",
                "tabBtn": "#tab-google-btn"
              }
            },
            "emailForm": {
              "formId": "#email-auth-form",
              "modes": [
                "Sign In",
                "Sign Up (toggled via #toggle-auth-mode-btn)"
              ],
              "inputs": [
                "#email-name-input (sign-up only)",
                "#email-address-input",
                "#email-password-input"
              ],
              "passwordToggle": "#toggle-password-btn"
            },
            "googleButton": "#custom-google-btn → authInstance.loginWithGoogle()"
          },
          "profileModal": {
            "overlay": "#profile-modal",
            "displays": [
              "#profile-avatar-display",
              "#profile-name-display",
              "#profile-detail-display",
              "#profile-provider-badge"
            ],
            "favoritesGrid": "#favorites-items-list",
            "updateForm": "#update-profile-form → authInstance.updateProfile()"
          }
        },
        "notifications": {
          "toastSystem": {
            "container": "#toast-container",
            "function": "showToast(msg, type, duration)",
            "types": [
              "success",
              "info",
              "error"
            ],
            "defaultDuration": 4000
          },
          "authAlerts": {
            "element": "#auth-alert",
            "functions": [
              "showAlert(msg, type)",
              "hideAlert()"
            ]
          }
        }
      },
      "security": {
        "xssProtection": "escapeHtml() utility applied to all dynamic content rendering"
      }
    }
  },
  "htmlSections": {
    "head": {
      "seo": {
        "title": "Komorebi Cafe — Cozy Artisanal Coffee & Ceremonial Matcha Nook",
        "metaTags": [
          "description",
          "keywords",
          "robots",
          "language",
          "author",
          "canonical"
