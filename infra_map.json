{
  "project": {
    "name": "small-biz-prototype",
    "displayName": "Komorebi Cafe",
    "version": "1.0.0",
    "description": "Cozy Artisanal Coffee & Ceremonial Matcha Nook — SEO showcase single-page website with Firebase authentication, WhatsApp integration, and dynamic menu system.",
    "type": "module",
    "entryPoint": "index.html",
    "license": "ISC",
    "author": "Komorebi Cafe"
  },
  "buildSystem": {
    "bundler": "vite",
    "bundlerVersion": "^6.0.0",
    "scripts": {
      "dev": "vite",
      "build": "vite build",
      "preview": "vite preview"
    }, 
    "outputDir": "dist/",
    "buildArtifacts": {
      "html": "dist/index.html",
      "js": "dist/assets/index-BBbW8IYZ.js",
      "css": "dist/assets/index-Buz84_xx.css",
      "images": [
        "dist/assets/corner-3seXoB9Y.jpg",
        "dist/assets/hero-DCPXgjOc.jpg",
        "dist/assets/matcha-CPOGk8ra.jpg",
        "dist/assets/pastries-CEmZ116s.jpg"
      ]
    }
  },
  "dependencies": {
    "runtime": {
      "firebase": {
        "version": "^12.16.0",
        "purpose": "Authentication backend (Email/Password, Google OAuth, Phone SMS)",
        "modules": [
          "firebase/app",
          "firebase/auth"
        ]
      }
    },
    "devDependencies": {
      "vite": {
        "version": "^6.0.0",
        "purpose": "Development server & production bundler"
      }
    },
    "external": {
      "googleFonts": {
        "url": "https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap",
        "fonts": [
          "Lora (serif)",
          "Plus Jakarta Sans (sans-serif)"
        ]
      },
      "googleIdentityServices": {
        "url": "https://accounts.google.com/gsi/client",
        "purpose": "Google Sign-In client library (loaded async)"
      }
    }
  },
  "fileTree": {
